# Resend — https://resend.com (subscribers live in Resend Contacts, not in git)
RESEND_API_KEY=re_xxxxxxxx
# Verified sender, e.g. The Paramaribo Letter <letter@yourdomain.com>
RESEND_FROM_EMAIL=The Paramaribo Letter <onboarding@resend.dev>
# Optional: Resend Segment id so contacts are grouped as "Paramaribo Letter"
RESEND_SEGMENT_ID=seg_xxxxxxxx

# Shared secret for /api/notify (also set as GitHub Actions secret NOTIFY_SECRET)
NOTIFY_SECRET=long-random-string

# Public site URL used in email links
SITE_URL=https://paramaribo-letter.vercel.app
