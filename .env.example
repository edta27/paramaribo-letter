# Resend — https://resend.com (subscribers live in Resend Contacts, not in git)
RESEND_API_KEY=re_xxxxxxxx
# Must be a verified Resend domain — not @gmail.com.
# Ideal: The Paramaribo Letter <letter@paramariboletter.com>
# Inbox for human replies (separate): paramariboletter@gmail.com
RESEND_FROM_EMAIL=The Paramaribo Letter <letter@paramariboletter.com>
# Optional: where reader replies go (Gmail inbox is fine here)
RESEND_REPLY_TO=paramariboletter@gmail.com
# Optional: Resend Segment id so contacts are grouped as "Paramaribo Letter"
RESEND_SEGMENT_ID=seg_xxxxxxxx

# Shared secret for /api/notify (also set as GitHub Actions secret NOTIFY_SECRET)
NOTIFY_SECRET=long-random-string

# Public site URL used in email links
SITE_URL=https://www.paramariboletter.com
