{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/marketing/launch-status.md", "destination": "/marketing/launch-status.html" },
    { "source": "/marketing/linkedin-launch.md", "destination": "/marketing/linkedin-launch.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 60
    }
  }
}
