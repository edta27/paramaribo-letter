{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/marketing/:slug.md",
      "destination": "/marketing/:slug",
      "permanent": true
    },
    {
      "source": "/issue.html",
      "destination": "/issue",
      "permanent": false
    },
    {
      "source": "/case-studies",
      "destination": "/cases",
      "permanent": false
    },
    {
      "source": "/investor-case-studies",
      "destination": "/cases",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 60
    }
  }
}
